# dependencies
node_modules/

# build outputs (regenerable)
dist/
dist-pptx/
dist-pdf/
dist-single/
packages/*/lib/
.vite/

# regenerable caches (baked via `npm run pptx:bake`)
# scripts/pptx/backdrops/ is deliberately NOT ignored: baking a backdrop
# needs a browser, and the dsh-deck plugin vendors these PNGs so exporting
# a deck from the harness never has to launch one. They are per-theme and
# deck-independent, so they change only when a theme's gradient changes.

# secrets / local config — DO NOT COMMIT
.mcp.json
.env
.env.*
*.local

# local tooling / agent state (not part of the distributable)
.claude/
.playwright-mcp/
.agents/

# legacy singular skill dir (eval scratch); canonical skill is skills/
skill/

# deck-research inputs (not part of the framework)
input/

# Scaffolded decks are personal, not repository content. `npm run new:deck`
# writes a deck here and an entry HTML at the root; vite.config.ts discovers
# the entry, so neither needs to be tracked.
/src/decks/*
!/src/decks/.gitkeep
/*.html
!/index.html

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# logs
*.log
npm-debug.log*
dist-*/

# SDD scratch (ledger, briefs, review packages) — not part of the distributable
.superpowers/

# generated by packages/dsh-deck/scripts/vendor-framework.mjs
packages/*/vendor/
