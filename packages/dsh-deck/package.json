{
  "name": "@onetest/dsh-deck",
  "version": "0.2.0",
  "description": "Octodeck deck capability for DeepSeek Harness: deck tools, a live preview server, and the deck canvas",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "octodeck",
    "presentation",
    "slides",
    "deck"
  ],
  "license": "MIT",
  "homepage": "https://github.com/onetest-ai/octodeck/tree/main/packages/dsh-deck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onetest-ai/octodeck.git",
    "directory": "packages/dsh-deck"
  },
  "bugs": {
    "url": "https://github.com/onetest-ai/octodeck/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "runtime/**",
    "vendor/**",
    "presets/**"
  ],
  "scripts": {
    "build": "npm run vendor && tsc -p tsconfig.json && tsdown",
    "bundle": "tsdown",
    "pretypecheck": "npm run vendor",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json",
    "pretest": "npm run vendor && tsdown",
    "test": "vitest run",
    "vendor": "node scripts/vendor-framework.mjs && tsc -p tsconfig.vendor.json && node scripts/prune-vendor-sources.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-tool": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "*",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.19.0",
    "@types/react": "~18.3.1",
    "@types/ws": "^8.5.0",
    "jsdom": "^25.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
