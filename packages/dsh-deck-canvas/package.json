{
  "name": "@onetest/dsh-deck-canvas",
  "version": "0.0.0",
  "description": "Deck preview canvas for DeepSeek Harness: deck_view keyed tool-call view",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "platform": "web" } },
  "scripts": { "bundle": "tsdown", "pretest": "tsdown", "test": "vitest run", "typecheck": "tsc -p tsconfig.json" },
  "files": ["lib/index.js", "lib/client.js"],
  "engines": { "node": "^22.19 || >=24" },
  "peerDependencies": { "@deepseek-ai/cordis": "*" },
  "devDependencies": {
